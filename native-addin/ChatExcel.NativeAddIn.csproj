<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>ChatExcel.NativeAddIn</AssemblyName>
    <RootNamespace>ChatExcel.NativeAddIn</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly Condition="Exists('ChatExcel.NativeAddIn.snk')">true</SignAssembly>
    <SignAssembly Condition="!Exists('ChatExcel.NativeAddIn.snk')">false</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('ChatExcel.NativeAddIn.snk')">ChatExcel.NativeAddIn.snk</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <OfficePiaDirectory Condition="'$(OfficePiaDirectory)' == ''">$(windir)\assembly\GAC_MSIL</OfficePiaDirectory>
    <ExtensibilityAssembly Condition="'$(ExtensibilityAssembly)' == ''">$(MSBuildProgramFiles32)\Common Files\Microsoft Shared\MSEnv\PublicAssemblies\Extensibility.dll</ExtensibilityAssembly>
    <WebView2PackageDirectory Condition="'$(WebView2PackageDirectory)' == ''">$(UserProfile)\.nuget\packages\microsoft.web.webview2\1.0.4078.44</WebView2PackageDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="!Exists('$(ExtensibilityAssembly)')">
    <ExtensibilityAssembly>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\PublicAssemblies\Extensibility.dll</ExtensibilityAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.Excel">
      <HintPath>$(OfficePiaDirectory)\Microsoft.Office.Interop.Excel\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="office">
      <HintPath>$(OfficePiaDirectory)\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Extensibility">
      <HintPath>$(ExtensibilityAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(WebView2PackageDirectory)\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(WebView2PackageDirectory)\lib\net462\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(WebView2PackageDirectory)\runtimes\win-x64\native\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateOfficeReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OfficePiaDirectory)\Microsoft.Office.Interop.Excel\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Excel.dll')"
           Text="Microsoft.Office.Interop.Excel 15.0 PIA was not found. Set OfficePiaDirectory to the GAC_MSIL directory that contains the installed Office PIAs." />
    <Error Condition="!Exists('$(OfficePiaDirectory)\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL')"
           Text="office 15.0 PIA was not found. Set OfficePiaDirectory to the GAC_MSIL directory that contains the installed Office PIAs." />
    <Error Condition="!Exists('$(ExtensibilityAssembly)')"
           Text="Extensibility.dll was not found. Set ExtensibilityAssembly to an installed Visual Studio PublicAssemblies Extensibility.dll path." />
    <Error Condition="!Exists('$(WebView2PackageDirectory)\lib\net462\Microsoft.Web.WebView2.WinForms.dll')"
           Text="Microsoft.Web.WebView2 1.0.4078.44 was not found. Restore the package or set WebView2PackageDirectory." />
  </Target>
</Project>
